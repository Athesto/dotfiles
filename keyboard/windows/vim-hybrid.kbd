;; Athesto Keyboard - Windows / Kanata
;; Version: 2026.08.20.11
;;
;; Caps double tap -> Escape
;; Caps hold       -> Vim Hybrid
;; Caps+Space      -> QWERTY / Colemak-DH
;; Caps+RightShift -> Caps Lock
;; Right Win       -> Right Alt
;;
;; Vim Hybrid semantics:
;;   no modifier -> character
;;   Alt         -> word
;;   Ctrl        -> line/document
;;   Shift       -> selection
;;
;; The fork actions inspect held modifiers, so Alt/Ctrl/Shift may be pressed
;; before or after Caps. Alt takes precedence if Alt and Ctrl are both active.

(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
)

(defsrc
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defalias
  caps-q (tap-hold-press 200 200 (tap-dance 300 (XX esc)) (layer-while-held vim-qwerty))
  caps-c (tap-hold-press 200 200 (tap-dance 300 (XX esc)) (layer-while-held vim-colemak))

  ;; Preserve Escape; only Left Shift+Escape produces tilde.
  escape-tilde (fork esc grv (lsft))

  ;; Match the macOS layer using native Windows actions.
  screenshot-clipboard M-S-s
  scroll-up (mwheel-up 50 120)
  scroll-down (mwheel-down 50 120)

  to-qwerty (multi
              (layer-switch qwerty)
              (cmd cmd.exe /d /c "echo qwerty>runtime\layer-notification.txt"))
  to-colemak (multi
               (layer-switch colemak)
               (cmd cmd.exe /d /c "echo colemak>runtime\layer-notification.txt"))

  ;; Spanish character entry on the standard Windows US layout.
  a-acute (fork (unicode á) (unicode Á) (lsft rsft))
  e-acute (fork (unicode é) (unicode É) (lsft rsft))
  i-acute (fork (unicode í) (unicode Í) (lsft rsft))
  o-acute (fork (unicode ó) (unicode Ó) (lsft rsft))
  u-acute (fork (unicode ú) (unicode Ú) (lsft rsft))
  u-diaeresis (fork (unicode ü) (unicode Ü) (lsft rsft))
  enye (fork (unicode ñ) (unicode Ñ) (lsft rsft))

  acute-q (one-shot 2000 (layer-while-held acute-qwerty))
  acute-c (one-shot 2000 (layer-while-held acute-colemak))
  diaeresis-q (one-shot 2000 (layer-while-held diaeresis-qwerty))
  diaeresis-c (one-shot 2000 (layer-while-held diaeresis-colemak))
  tilde-q (one-shot 2000 (layer-while-held tilde-qwerty))
  tilde-c (one-shot 2000 (layer-while-held tilde-colemak))

  enye-q (fork (unicode ñ) @tilde-q (lsft rsft))
  enye-c (fork (unicode ñ) @tilde-c (lsft rsft))
  pageup-diaeresis-q (fork pgup @diaeresis-q (lsft rsft))
  pageup-diaeresis-c (fork pgup @diaeresis-c (lsft rsft))
  f1-inverted-exclamation (fork f1 (unicode ¡) (lsft rsft))
  slash-inverted-question (fork / (unicode ¿) (lsft rsft))

  ;; Horizontal movement: character / line / word.
  nav-h (fork
          (fork left
                (unmod (lctl rctl lalt ralt rmet) home)
                (lctl rctl))
          (unmod (lctl rctl lalt ralt rmet) lctl left)
          (lalt ralt rmet))

  nav-l (fork
          (fork rght
                (unmod (lctl rctl lalt ralt rmet) end)
                (lctl rctl))
          (unmod (lctl rctl lalt ralt rmet) lctl rght)
          (lalt ralt rmet))

  ;; Vertical movement: line / document / paragraph.
  nav-j (fork
          (fork down
                (unmod (lctl rctl lalt ralt rmet) lctl end)
                (lctl rctl))
          (unmod (lctl rctl lalt ralt rmet) lctl down)
          (lalt ralt rmet))

  nav-k (fork
          (fork up
                (unmod (lctl rctl lalt ralt rmet) lctl home)
                (lctl rctl))
          (unmod (lctl rctl lalt ralt rmet) lctl up)
          (lalt ralt rmet))

  ;; Backward deletion: character / line / word.
  del-w (fork
          (fork (unmod (lsft rsft) bspc)
                (macro
                  (unmod (lctl rctl lalt ralt rmet lsft rsft) lsft home)
                  bspc)
                (lctl rctl))
          (unmod (lctl rctl lalt ralt rmet lsft rsft) lctl bspc)
          (lalt ralt rmet))

  ;; Forward deletion: character / line / word.
  del-x (fork
          (fork (unmod (lsft rsft) del)
                (macro
                  (unmod (lctl rctl lalt ralt rmet lsft rsft) lsft end)
                  del)
                (lctl rctl))
          (unmod (lctl rctl lalt ralt rmet lsft rsft) lctl del)
          (lalt ralt rmet))
)

;; QWERTY base. Escape stays Escape; Left Shift+Escape produces tilde.
(deflayer qwerty
  @escape-tilde 1  2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @caps-q a  s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt ralt rctl
)

;; Colemak-DH ANSI with Angle Mod.
(deflayer colemak
  @escape-tilde 1  2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    f    p    b    j    l    u    y    ;    [    ]    \
  @caps-c a  r    s    t    g    m    n    e    i    o    '    ret
  lsft x    c    d    v    z    k    h    ,    .    /    rsft
  lctl lmet lalt           spc            ralt ralt rctl
)

;; Vim Hybrid while QWERTY is the base layout.
(deflayer vim-qwerty
  grv  @f1-inverted-exclamation f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 C-bspc
  _    A-f4 _      end  _    _    _    @pageup-diaeresis-q tab _ _ esc _ _
  _    home @screenshot-clipboard pgdn _ _ @nav-h @nav-j @nav-k @nav-l @del-w @acute-q ret
  _    _    @del-x _  _    _    @enye-q ret @scroll-up @scroll-down @slash-inverted-question caps
  _    _    _              @to-colemak    _    _    _
)

;; Vim Hybrid while Colemak-DH is the base layout. Navigation remains on the
;; same physical QWERTY positions; only Space switches back to QWERTY.
(deflayer vim-colemak
  grv  @f1-inverted-exclamation f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 C-bspc
  _    A-f4 _      end  _    _    _    @pageup-diaeresis-c tab _ _ esc _ _
  _    home @screenshot-clipboard pgdn _ _ @nav-h @nav-j @nav-k @nav-l @del-w @acute-c ret
  _    _    @del-x _  _    _    @enye-c ret @scroll-up @scroll-down @slash-inverted-question caps
  _    _    _              @to-qwerty     _    _    _
)

;; One-shot accent layers follow the active typing layout. Unmapped keys are
;; transparent and consume the one-shot without changing their normal output.
(deflayer acute-qwerty
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ @e-acute _ _ _ @u-acute @i-acute @o-acute _ _ _ _
  _ @a-acute _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _
)

(deflayer acute-colemak
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ @u-acute _ _ _ _ _
  _ @a-acute _ _ _ _ _ _ @e-acute @i-acute @o-acute _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _
)

(deflayer diaeresis-qwerty
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ @u-diaeresis _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _
)

(deflayer diaeresis-colemak
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ @u-diaeresis _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _
)

(deflayer tilde-qwerty
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ @enye _ _ _ _ _
  _ _ _ _ _ _ _
)

(deflayer tilde-colemak
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ @enye _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _
)
