;; Athesto Keyboard - Linux / Kanata
;;
;; Caps tap        -> Escape
;; Caps hold       -> Vim Hybrid
;; Caps+Space      -> QWERTY / Colemak-DH
;; Caps+RightShift -> Caps Lock
;; Right Win       -> Right Alt
;;
;; Navigation emits plain arrow keys and preserves incoming modifiers.
;; Home and End remain available through Caps+A and Caps+E.

(defcfg
  process-unmapped-keys yes
  linux-unicode-termination enter
  linux-output-device-name "Athesto Keyboard"
)

(defsrc
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defalias
  caps-q (tap-hold-press 200 200 esc (layer-while-held vim-qwerty))
  caps-c (tap-hold-press 200 200 esc (layer-while-held vim-colemak))

  to-qwerty (layer-switch qwerty)
  to-colemak (layer-switch colemak)

  ;; Spanish character entry on the standard US layout.
  a-acute (fork (unicode á) (unicode Á) (lsft rsft))
  e-acute (fork (unicode é) (unicode É) (lsft rsft))
  i-acute (fork (unicode í) (unicode Í) (lsft rsft))
  o-acute (fork (unicode ó) (unicode Ó) (lsft rsft))
  u-acute (fork (unicode ú) (unicode Ú) (lsft rsft))
  u-diaeresis (fork (unicode ü) (unicode Ü) (lsft rsft))
  enye (fork (unicode ñ) (unicode Ñ) (lsft rsft))

  acute-q (one-shot 2000 (layer-while-held acute-qwerty))
  acute-c (one-shot 2000 (layer-while-held acute-colemak))
  diaeresis-q (one-shot 2000 (layer-while-held diaeresis-qwerty))
  diaeresis-c (one-shot 2000 (layer-while-held diaeresis-colemak))
  tilde-q (one-shot 2000 (layer-while-held tilde-qwerty))
  tilde-c (one-shot 2000 (layer-while-held tilde-colemak))

  enye-q (fork (unicode ñ) @tilde-q (lsft rsft))
  enye-c (fork (unicode ñ) @tilde-c (lsft rsft))
  pageup-diaeresis-q (fork pgup @diaeresis-q (lsft rsft))
  pageup-diaeresis-c (fork pgup @diaeresis-c (lsft rsft))
  f1-inverted-exclamation (fork f1 (unicode ¡) (lsft rsft))
  slash-inverted-question (fork / (unicode ¿) (lsft rsft))
)

;; QWERTY base. The physical Esc position produces grave/tilde.
(deflayer qwerty
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @caps-q a  s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt ralt rctl
)

;; Colemak-DH ANSI with Angle Mod.
(deflayer colemak
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    f    p    b    j    l    u    y    ;    [    ]    \
  @caps-c a  r    s    t    g    m    n    e    i    o    '    ret
  lsft x    c    d    v    z    k    h    ,    .    /    rsft
  lctl lmet lalt           spc            ralt ralt rctl
)

;; Vim Hybrid while QWERTY is the base layout.
(deflayer vim-qwerty
  _    @f1-inverted-exclamation f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 C-bspc
  _    A-f4 bspc end  _    _    _    @pageup-diaeresis-q tab _ _ esc _ _
  _    home prnt pgdn _    _    left down up rght _  @acute-q ret
  _    _    del  _  _    _    @enye-q ret  _    _    @slash-inverted-question caps
  _    _    _              @to-colemak    _    _    _
)

;; Vim Hybrid while Colemak-DH is the base layout. Navigation remains on the
;; same physical QWERTY positions; only Space switches back to QWERTY.
(deflayer vim-colemak
  _    @f1-inverted-exclamation f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 C-bspc
  _    A-f4 bspc end  _    _    _    @pageup-diaeresis-c tab _ _ esc _ _
  _    home prnt pgdn _    _    left down up rght _  @acute-c ret
  _    _    del  _  _    _    @enye-c ret  _    _    @slash-inverted-question caps
  _    _    _              @to-qwerty     _    _    _
)

;; One-shot accent layers follow the active typing layout. Unmapped keys are
;; transparent and consume the one-shot without changing their normal output.
(deflayer acute-qwerty
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ @e-acute _ _ _ @u-acute @i-acute @o-acute _ _ _ _
  _ @a-acute _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _
)

(deflayer acute-colemak
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ @u-acute _ _ _ _ _
  _ @a-acute _ _ _ _ _ _ @e-acute @i-acute @o-acute _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _
)

(deflayer diaeresis-qwerty
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ @u-diaeresis _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _
)

(deflayer diaeresis-colemak
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ @u-diaeresis _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _
)

(deflayer tilde-qwerty
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ @enye _ _ _ _ _
  _ _ _ _ _ _ _
)

(deflayer tilde-colemak
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ @enye _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _
)
